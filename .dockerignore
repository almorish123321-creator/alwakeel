# Git
.git
.gitignore

# Environment files
.env

# Python cache
__pycache__/
*.py[cod]
.venv/
venv/

# Node.js runtime modules (installed in container)
node_modules

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Exclude non-essential dirs
web/
docs/
examples/
tests/
scripts/
logs/
*.log

# Exclude build artifacts
backend/.venv
backend/htmlcov
backend/.coverage

# Extension manager snapshots
!backend/extensions/
!backend/extensions/sources/
!backend/extensions/sources/**
