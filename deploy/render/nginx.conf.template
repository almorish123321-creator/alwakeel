events {
    worker_connections 256;
}
pid /tmp/nginx.pid;
http {
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    error_log /dev/stderr;

    upstream gateway {
        server 127.0.0.1:8001;
        keepalive 16;
    }

    server {
        listen __RENDER_PORT__ default_server;
        listen [::]:__RENDER_PORT__ default_server;
        server_name _;
        client_max_body_size 50M;

        # API proxy
        location /api/ {
            proxy_pass http://gateway;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection '';
            proxy_set_header X-Accel-Buffering no;
            proxy_buffering off;
            proxy_cache off;
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 600s;
        }

        # Health & docs
        location /health { proxy_pass http://gateway; proxy_set_header Host $http_host; }
        location /docs { proxy_pass http://gateway; proxy_set_header Host $http_host; }
        location /redoc { proxy_pass http://gateway; proxy_set_header Host $http_host; }
        location /openapi.json { proxy_pass http://gateway; proxy_set_header Host $http_host; }

        # Chat UI
        location = / {
            root /app/deploy/render;
            index chat.html;
        }

        # Fallback
        location / {
            root /app/deploy/render;
            try_files $uri /chat.html;
        }
    }
}
